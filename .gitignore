# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# visual verification captures (scripts/visual-check.ts)
.visual/

# hook markers (.claude/hooks/)
.skill-read
.visual-pending

# portfolio export PNGs (scripts/capture-screenshot.ts), kept on disk only
projects/*/*/screenshots/

# personal Claude Code permissions (per machine)
.claude/settings.local.json
